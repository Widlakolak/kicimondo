# Copy into .env.production with mode 0600 and replace the release references.
KICIMONDO_RELEASE_SHA=REPLACE_WITH_APPROVED_COMMIT
KICIMONDO_FRONTEND_IMAGE=ghcr.io/widlakolak/kicimondo/frontend@sha256:REPLACE_WITH_RELEASE_DIGEST
KICIMONDO_BACKEND_IMAGE=ghcr.io/widlakolak/kicimondo/backend@sha256:REPLACE_WITH_RELEASE_DIGEST
# Compose supplies a pinned PostgreSQL default. Set this only for an approved override.
# KICIMONDO_POSTGRES_IMAGE=postgres@sha256:REPLACE_WITH_APPROVED_DIGEST

KICIMONDO_DB_NAME=kicimondo
KICIMONDO_DB_USER=kicimondo
# Set a generated password for full deployment. Frontend-only can leave it blank.
KICIMONDO_DB_PASSWORD=
KICIMONDO_FRONTEND_MEMORY=64m
KICIMONDO_BACKEND_MEMORY=512m
KICIMONDO_POSTGRES_MEMORY=256m
KICIMONDO_JVM_OPTIONS="-Xmx256m -XX:ActiveProcessorCount=2 -XX:UseAVX=0"

# Set the existing network name only when using compose.proxy.yaml.
KICIMONDO_PROXY_NETWORK=
# Optional comma-separated exact origins. Android uses https://localhost.
KICIMONDO_ALLOWED_ORIGINS=
# Used only by compose.local.yaml.
KICIMONDO_WEB_PORT=8088
